# Copy to .env.local for local development. Set the same values in Vercel project settings.
# Milestone 2 needs the three Supabase values; milestone 4 adds the Azure voice; later milestones add the rest.
# Only the two NEXT_PUBLIC_ values are ever sent to the browser (scripts/check-bundle.mjs verifies this after every build).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: PIN hashes and the verify-pin rate limit
ANTHROPIC_API_KEY=                # server only
ANTHROPIC_MODEL=claude-sonnet-5-5
# Juno's voice (milestone 4). Create an Azure "Speech" resource, then copy one of its two keys and its region here.
# With these unset, Juno uses the device's built-in voice as in milestone 1. If the Azure voice fails, she falls back to it.
AZURE_SPEECH_KEY=                 # server only; it never reaches the browser, which only fetches finished audio
AZURE_SPEECH_REGION=              # the resource's region, lowercase, e.g. westus2 or eastus
AZURE_TTS_VOICE=en-US-AvaNeural   # warm and young-sounding; also good: en-US-EmmaNeural, en-US-JennyNeural, en-US-AnaNeural (a child)
# AZURE_TTS_ENDPOINT=             # optional: a private or sovereign-cloud TTS URL instead of the one built from the region
BREVO_API_KEY=                    # optional, server only
PARENT_NOTIFY_PHONE=              # optional
PARENT_NOTIFY_EMAIL=              # optional
