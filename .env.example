# Copy to .env.local for local development. Set the same values in Vercel project settings.
# Milestone 1 (browser speech + localStorage) needs none of these; later milestones add them.
# Only the two NEXT_PUBLIC_ values are ever sent to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
ANTHROPIC_API_KEY=                # server only
ANTHROPIC_MODEL=claude-sonnet-5-5
AZURE_SPEECH_KEY=                 # server only
AZURE_SPEECH_REGION=              # e.g. westus2
AZURE_TTS_VOICE=en-US-AvaNeural   # pick a warm, young-sounding voice
BREVO_API_KEY=                    # optional, server only
PARENT_NOTIFY_PHONE=              # optional
PARENT_NOTIFY_EMAIL=              # optional
